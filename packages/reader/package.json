{
  "name": "@optaldk/reader",
  "type": "module",
  "description": "The reader for extracting admission figures from CSV-files with KOT data.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "analyze": "tsx ./src/analyze.ts",
    "coverage": "vitest run --coverage",
    "format": "prettier --ignore-path ../../.prettierignore --write . && eslint . --fix",
    "gen": "tsx ./src/generate.ts",
    "lint": "prettier --ignore-path ../../.prettierignore --check . && eslint .",
    "test:watch": "vitest",
    "test": "vitest run"
  },
  "devDependencies": {
    "@optaldk/eslint-config-custom": "*",
    "@optaldk/i18n": "*",
    "@types/papaparse": "^5.5.2",
    "@vitest/coverage-v8": "^4.1.10",
    "lodash": "^4.18.1",
    "papaparse": "^5.5.4",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.0/xlsx-0.20.0.tgz"
  }
}
