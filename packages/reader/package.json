{
  "name": "@optaldk/reader",
  "type": "module",
  "description": "The reader for extracting admission figures from CSV-files with KOT data.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "coverage": "vitest run --coverage",
    "format": "prettier --ignore-path ../../.prettierignore --write . && eslint . --fix",
    "gen": "npx tsx ./src/generate.ts",
    "lint": "prettier --ignore-path ../../.prettierignore --check . && eslint .",
    "test:watch": "vitest",
    "test": "vitest run"
  },
  "dependencies": {
    "lodash": "^4.17.21",
    "papaparse": "^5.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.0",
    "vitest": "^1.2.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.0/xlsx-0.20.0.tgz"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^1.2.2",
    "@optaldk/eslint-config-custom": "*"
  }
}
