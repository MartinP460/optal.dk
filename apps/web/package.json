{
  "name": "web",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "dev": "vite dev",
    "format": "prettier --ignore-path ../../.prettierignore --write . && eslint . --fix",
    "lint": "prettier --ignore-path ../../.prettierignore --check . && eslint .",
    "postbuild": "npx svelte-sitemap --out-dir .vercel/output/static  --domain https://www.optal.dk",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@lucide/svelte": "^0.525.0",
    "@optaldk/eslint-config-custom": "*",
    "@optaldk/reader": "*",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.25.1",
    "@sveltejs/vite-plugin-svelte": "^6.1.0",
    "@tabler/icons-svelte": "^3.34.0",
    "@tailwindcss/postcss": "^4.1.11",
    "@tailwindcss/typography": "^0.5.16",
    "@types/lodash": "^4.17.20",
    "@unovis/svelte": "^1.5.2",
    "@unovis/ts": "^1.5.2",
    "autoprefixer": "^10.4.21",
    "bits-ui": "^2.8.11",
    "clsx": "^2.1.1",
    "fuse.js": "^7.1.0",
    "lodash": "^4.17.21",
    "mode-watcher": "^1.1.0",
    "paneforge": "^1.0.0",
    "postcss": "^8.4.27",
    "slugify": "^1.6.6",
    "svelte": "^5.34.6",
    "svelte-check": "^4.3.0",
    "svelte-sitemap": "^2.7.1",
    "sveltekit-search-params": "^3.0.0",
    "tailwind-merge": "^3.3.1",
    "tailwind-variants": "^1.0.0",
    "tailwindcss": "^4.1.11",
    "tslib": "^2.4.1",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5.5.0",
    "vaul-svelte": "^1.0.0-next.7",
    "vite": "^7.0.5",
    "zod": "^4.0.5"
  }
