{
  "name": "web",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "dev": "vite dev",
    "format": "prettier --ignore-path ../../.prettierignore --write . && eslint . --fix",
    "lint": "prettier --ignore-path ../../.prettierignore --check . && eslint .",
    "postbuild": "npx svelte-sitemap --out-dir .vercel/output/static  --domain https://www.optal.dk",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@lucide/svelte": "^1.27.0",
    "@optaldk/eslint-config-custom": "*",
    "@optaldk/i18n": "*",
    "@optaldk/reader": "*",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tabler/icons-svelte": "^3.45.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/lodash": "^4.17.24",
    "@unovis/svelte": "^1.6.7",
    "@unovis/ts": "^1.6.7",
    "autoprefixer": "^10.5.4",
    "bits-ui": "^1.8.0",
    "clsx": "^2.1.1",
    "fuse.js": "^7.5.0",
    "lodash": "^4.18.1",
    "mode-watcher": "^1.1.0",
    "paneforge": "^1.0.2",
