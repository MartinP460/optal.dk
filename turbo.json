{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV", "SUPABASE_URL", "SUPABASE_ANON_KEY", "OPTAL_WEB_DOMAIN"],
  "tasks": {
    "analyze:new-courses": {},
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".svelte-kit/**", ".vercel/**"]
    },
    "lint": {},
    "format": {},
    "test": {},
    "gen": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test:watch": {},
    "coverage": {},
    "preview": {
      "cache": false,
      "persistent": true
    },
    "check": {},
    "check:watch": {},
    "sb:diff": {
      "cache": false
    },
    "sb:migrate-latest": {
      "cache": false
    },
    "sb:migrate-new": {
      "cache": false
    },
    "sb:pull": {
      "cache": false
    },
    "sb:push": {
      "cache": false
    },
    "sb:reset": {
      "cache": false
    },
    "sb:start": {
      "cache": false
    },
    "sb:status": {
      "cache": false
    },
    "sb:stop": {
      "cache": false
    }
  }
}
