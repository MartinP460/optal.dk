{
  "$schema": "https://turbo.build/schema.json",
  "pipeline": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".svelte-kit/**", ".vercel/**"]
    },
    "vercel-build": {
      "outputs": [".vercel/**"]
    },
    "lint": {},
    "test": {},
    "gen": {
      "outputs": [".static/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "run-dev": {
      "cache": false,
      "persistent": true
    }
  },
  "globalEnv": ["SUPABASE_URL", "SUPABASE_ANON_KEY"]
}
