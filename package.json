{
  "name": "optal-workspace",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test --filter=parser",
    "gen": "turbo run gen --filter=parser -- /apps/web/static /apps/web/src/lib/server && npm run format",
    "lint": "prettier --plugin-search-dir . --check . && eslint .",
    "format": "prettier --write .",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "eslint": "^8.0.0",
    "eslint-config-custom": "*",
    "husky": "^8.0.0",
    "prettier": "^2.7.1",
    "prettier-plugin-svelte": "^2.7.0",
    "supabase": "^1.142.1",
    "turbo": "latest"
  },
  "packageManager": "npm@10.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
