{
  "name": "optal-workspace",
  "private": true,
  "scripts": {
    "api:dev": "turbo run run-dev --filter=api",
    "api:sb:diff": "turbo run sb:diff --filter=api",
    "api:sb:migrate-latest": "turbo run sb:migrate-latest --filter=api",
    "api:sb:migrate-new": "turbo run sb:migrate-new --filter=api",
    "api:sb:pull": "turbo run sb:pull --filter=api",
    "api:sb:push": "turbo run sb:push --filter=api",
    "api:sb:reset": "turbo run sb:reset --filter=api",
    "api:sb:start": "turbo run sb:start --filter=api",
    "api:sb:status": "turbo run sb:status --filter=api",
    "api:sb:stop": "turbo run sb:stop --filter=api",
    "build": "turbo run build",
    "dev:web": "turbo run dev --filter=web",
    "dev": "turbo run dev",
    "format": "turbo run format",
    "lint": "turbo run lint",
    "prepare": "husky",
    "preview": "turbo run preview",
    "reader:analyze": "turbo run analyze --filter=@optaldk/reader",
    "reader:coverage": "turbo run coverage --filter=@optaldk/reader",
    "reader:gen": "turbo run gen --filter=@optaldk/reader -- /apps/web/static /apps/web/src/lib/server",
    "reader:gen:new": "turbo run gen:new --filter=@optaldk/reader -- /apps/web/static/data",
    "reader:test:watch": "turbo run test:watch --filter=@optaldk/reader",
    "reader:test": "turbo run test --filter=@optaldk/reader",
    "test:watch": "turbo run test:watch --filter=@optaldk/reader",
    "test": "turbo run test --filter=@optaldk/reader",
    "web:check:watch": "turbo run check:watch --filter=web",
    "web:check": "turbo run check --filter=web"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "prettier": "^3.5.3",
    "prettier-plugin-svelte": "^3.4.0",
    "turbo": "^2.5.5"
  },
  "packageManager": "npm@10.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
