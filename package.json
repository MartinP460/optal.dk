{
  "name": "optal-workspace",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run vercel-dev & turbo run dev",
    "test": "turbo run test --filter=parser",
    "gen": "turbo run gen --filter=parser -- /apps/web/static /apps/web/src/lib/server && npm run format",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write . && eslint . --fix",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "eslint": "^8.0.0",
    "eslint-config-custom": "*",
    "husky": "^9.0.10",
    "prettier": "^3.2.5",
    "prettier-plugin-svelte": "^3.1.2",
    "supabase": "^1.142.2",
    "turbo": "^1.12.3"
  },
  "packageManager": "npm@10.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
