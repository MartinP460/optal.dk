{
  "name": "optal-workspace",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev run-dev",
    "test": "turbo run test --filter=reader",
    "test:watch": "turbo run test:watch --filter=reader",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write . && eslint . --fix",
    "prepare": "husky install",
    "preview": "turbo run preview",
    "reader:test": "turbo run test --filter=reader",
    "reader:test:watch": "turbo run test:watch --filter=reader",
    "reader:coverage": "turbo run coverage --filter=reader",
    "reader:gen": "turbo run gen --filter=reader -- /apps/web/static /apps/web/src/lib/server",
    "web:check": "turbo run check --filter=web",
    "web:check:watch": "turbo run check:watch --filter=web",
    "api:dev": "turbo run run-dev --filter=api",
    "api:sb:diff": "turbo run sb:diff --filter=api",
    "api:sb:migrate-latest": "turbo run sb:migrate-latest --filter=api",
    "api:sb:migrate-new": "turbo run sb:migrate-new --filter=api",
    "api:sb:pull": "turbo run sb:pull --filter=api",
    "api:sb:push": "turbo run sb:push --filter=api",
    "api:sb:reset": "turbo run sb:reset --filter=api",
    "api:sb:start": "turbo run sb:start --filter=api",
    "api:sb:status": "turbo run sb:status --filter=api",
    "api:sb:stop": "turbo run sb:stop --filter=api"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "eslint": "^8.0.0",
    "eslint-config-custom": "*",
    "husky": "^9.0.10",
    "prettier": "^3.2.5",
    "prettier-plugin-svelte": "^3.1.2",
    "supabase": "^1.142.2",
    "turbo": "^1.12.3"
  },
  "packageManager": "npm@10.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
